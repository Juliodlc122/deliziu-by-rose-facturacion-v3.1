# DATA_DIR: Ruta del directorio para almacenar data/users.json y data/documents.json.
# En Render.com, apunta esto al punto de montaje de tu Persistent Disk (ej. /var/data).
DATA_DIR="./data"

# AUTH_SECRET: Secreto para firmar tokens de sesion (opcional; si se omite se genera uno persistente en DATA_DIR).
AUTH_SECRET=""

# ADMIN_PASSWORD: Contrasena inicial para la cuenta administrador Deliziubyrose al crear users.json por primera vez.
ADMIN_PASSWORD="Deliziu2026"

# PORT: Puerto del servidor HTTP (AI Studio usa 3000 por defecto; Render inyecta su propio PORT).
PORT="3000"
